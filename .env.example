# Salin ke .env lalu isi. JANGAN commit .env.
# Token bot dari @BotFather:
BOT_TOKEN=
# Kunci enkripsi Fernet — buat dengan:
# .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Opsional (default = server + publishable key game, publik by design):
# SUPABASE_URL=https://vfeihrxdwynivqcksxwl.supabase.co
# SUPABASE_KEY=sb_publishable_bGjm_-NNAqleprvQoE3dLA_IVYxzKmr
# Chat id Telegram yang boleh memakai bot, dipisah koma (kosong = semua):
# ALLOWED_CHAT_IDS=123456789
# Proxy egress eksplisit (opsional; kosong = koneksi langsung).
# WAJIB diisi di host tanpa internet langsung (mis. VM ini: egress lewat
# proxy). Kredensial proxy bisa berotasi — perbarui dari shell aktif dengan:
#   bash scripts/install-services.sh
# HTTPS_PROXY=http://user:pass@hatch-egress-proxy:3128
# HTTP_PROXY=http://user:pass@hatch-egress-proxy:3128
# Lokasi SQLite (default data/bot.db):
# DB_PATH=data/bot.db
# --- Fase 4: Mini App ---
# URL HTTPS publik Mini App (hasil build miniapp/dist, disajikan API).
# Kosong = tombol "Buka Dashboard" tidak muncul di bot chat.
# MINIAPP_URL=https://warung-bot.example.com/
# Bind API (default 127.0.0.1:8000 — di belakang reverse proxy/Tunnel):
# API_HOST=127.0.0.1
# API_PORT=8000
# Folder hasil build Mini App yang disajikan API (default miniapp/dist):
# MINIAPP_DIST=miniapp/dist
